command /pp1:
    trigger:
        set {_loc} to location of player
        play 40 end rod at {_loc}
command /pp2:
    trigger:
        set {_loc} to location of player
        play 40 end rod particles at {_loc}
command /pp3:
    trigger:
        set {_loc} to location of player
        play 40 end rod with offset vector(0.4, 0.4, 0.4) at {_loc}
command /pp4:
    trigger:
        set {_loc} to location of player
        play 40 end rod particles with offset vector(0.4, 0.4, 0.4) with extra 0.08 at {_loc}
command /pp5:
    trigger:
        set {_loc} to location of player
        play 40 end rod particle with offset (vector(0.4, 0.4, 0.4)) and extra 0.08 at {_loc}
command /pp6:
    trigger:
        set {_loc} to location of player
        play 40 totem of undying at {_loc}
command /pp7:
    trigger:
        set {_loc} to location of player
        play 8 happy villager at {_loc}
command /pp8:
    trigger:
        set {_loc} to location of player
        play 8 happy villager with offset vector(1, 1, 1) at {_loc}
command /pp9:
    trigger:
        set {_loc} to location of player
        play 8 happy villager particles with offset vector(1, 1, 1) with speed 0.1 at {_loc}
command /pp10:
    trigger:
        set {_loc} to location of player
        play 8 happy villager with offset vector(1, 1, 1) with extra 0 at {_loc}
