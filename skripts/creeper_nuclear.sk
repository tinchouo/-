# Guardar en: plugins/Skript/scripts/creeper_nuclear.sk   (luego /sk reload creeper_nuclear)
#
# CLICK DERECHO RAPIDO sobre el Creeper Nuclear  = montarse. Conduces con WASD hacia donde MIRAS; Shift para bajarte.
# MANTENER click derecho 5 s sobre el Creeper    = arma la bomba -> cuenta atras -> explosion.
# Al armarla, a todos: "BOMBA PLANTADA" / "¡Corran al búnker!". La cuenta dura 1 minuto y medio: la barra de arriba con el
# tiempo y los sonidos tod4:creeper.nuclear los ven y escuchan TODOS los jugadores.
# La explosion NO rompe nada: mata a todos los jugadores (supervivencia/aventura) que esten a 500 bloques o menos EN ESE MUNDO
# (el Nether y el End no cuentan: el portal no la deja pasar), menos a los que esten en una ZONA SEGURA (el bunker).
# Tambien mata a los mobs de al lado y deja el hongo de humo.
#
# /nuclear                  te da las dos herramientas:
#   Selector Nuclear  (vara)  click derecho a un bloque = lo agrega o lo saca de los bloques que desaparecen
#   Zona Segura       (pala)  click izquierdo = esquina 1, click derecho = esquina 2 -> se guarda la zona
# /nuclear bloque           agrega o saca el bloque que estas mirando (hasta 100 bloques)
# /nuclear ver              muestra 10 s los bloques elegidos (verde) y las esquinas de las zonas seguras (llamas)
# /nuclear lista            cuantos bloques y zonas hay
# /nuclear prueba [seg]     la cuenta SOLO PARA VOS (titulo, barra, sonidos, aviso de la zona y los bloques que desaparecen
#                           solo en tu pantalla). Nadie muere ni se entera; al final te dice si te salvabas. Sin seg: la cuenta entera.
# /nuclear restaurar        vuelven los bloques que desaparecieron
# /nuclear borrar bloques   /nuclear borrar zonas
# Los bloques elegidos desaparecen cuando a la cuenta le quedan "bloques-desaparecen" segundos (se guardan para restaurarlos).
# Durante la cuenta, al entrar a una zona segura te sale (solo a vos): "✔ Estás seguro."
# Es inmortal: no le entra ningun dano y queda despues de explotar (se puede volver a armar).
# Si sueltas despues de ~1 s y antes de los 5 s, se cancela el armado.
# Requiere Skript 2.10+ y Minecraft 1.21.2+ (teclas WASD) y NO depende de ModelEngine/BetterModel para montar.

options:
	nombre: Creeper Nuclear
	tiempo-mantener: 5
	# segundos de la cuenta regresiva (la barra de arriba) hasta que explota
	cuenta: 90
	# cuando a la cuenta le quedan estos segundos, desaparecen los bloques elegidos con el Selector Nuclear
	bloques-desaparecen: 60
	# mueren todos los jugadores a esta distancia o menos (solo en el mismo mundo)
	radio-muerte: 500
	# los mobs de al lado tambien mueren
	radio-mobs: 22
	velocidad: 0.28
	debug: 1
	giro: 25

on right click on pig:
	if name of event-entity is not set:
		stop
	if name of event-entity does not contain "{@nombre}":
		stop
	cancel the event
	set {_pig} to event-entity
	# inmortal (ademas de Invincible en MythicMobs)
	make {_pig} invulnerable
	set {_p} to player
	set {_id} to "%uuid of {_pig}%"
	if {-cnr::%{_id}%::armado} is set:
		stop
	set {_ahora} to now
	# Ignora el evento duplicado (mano principal + secundaria) del mismo click
	if {-cnr::%{_id}%::ultimo} is set:
		if difference between {-cnr::%{_id}%::ultimo} and {_ahora} is less than 0.1 seconds:
			stop
	# Ya hay un bucle en marcha: esto es solo otro pulso del click mantenido
	if {-cnr::%{_id}%::activo} is set:
		set {-cnr::%{_id}%::ultimo} to {_ahora}
		stop
	if {-cnr::%{_id}%::conduciendo} is set:
		stop

	# ---------- Click nuevo: distinguir toque (montar) de mantener (armar) ----------
	set {-cnr::%{_id}%::activo} to true
	set {-cnr::%{_id}%::ultimo} to {_ahora}
	set {_total} to {@tiempo-mantener} * 10
	set {_paso} to 0
	while {_paso} < {_total}:
		wait 2 ticks
		add 1 to {_paso}
		if {_pig} is dead:
			delete {-cnr::%{_id}%::*}
			stop
		if {_p} is not online:
			delete {-cnr::%{_id}%::*}
			stop
		# Dejo de llegar el click mantenido (llega uno cada ~0.2 s)
		if difference between {-cnr::%{_id}%::ultimo} and now is greater than 0.45 seconds:
			delete {-cnr::%{_id}%::*}
			if {_paso} is greater than 12:
				send action bar "§7Armado cancelado" to {_p}
				stop
			# ===== Fue un toque rapido: MONTARSE Y CONDUCIR =====
			if size of (passengers of {_pig}) is greater than 0:
				send action bar "§cYa esta ocupado" to {_p}
				stop
			make {_p} ride {_pig}
			set {-cnr::%{_id}%::conduciendo} to true
			send action bar "§aMontado §7- WASD para mover, Shift para bajar" to {_p}
			while vehicle of {_p} is {_pig}:
				set {_yaw} to yaw of {_p}
				set {_f} to 0
				set {_s} to 0
				if {_p} is pressing forward movement key:
					add 1 to {_f}
				if {_p} is pressing backward movement key:
					subtract 1 from {_f}
				if {_p} is pressing right movement key:
					add 1 to {_s}
				if {_p} is pressing left movement key:
					subtract 1 from {_s}
				set {_dbg} to {@debug}
				if {_dbg} is 1:
					send action bar "§7W/S: %{_f}%  A/D: %{_s}%" to {_p}
				set {_vel} to velocity of {_pig}
				set {_vy} to y component of {_vel}
				# ESPACIO = saltar (solo si esta en el suelo)
				if {_p} is pressing jump key:
					if {_pig} is on ground:
						set {_vy} to 0.52
				if {_f} is 0:
					if {_s} is 0:
						set velocity of {_pig} to vector(0, {_vy}, 0)
						wait 1 tick
						continue
				set {_dx} to ({_f} * (0 - sin({_yaw}))) + ({_s} * (0 - cos({_yaw})))
				set {_dz} to ({_f} * cos({_yaw})) + ({_s} * (0 - sin({_yaw})))
				set {_len} to sqrt(({_dx} * {_dx}) + ({_dz} * {_dz}))
				set {_dx} to {_dx} / {_len}
				set {_dz} to {_dz} / {_len}
				# Subir solos escalones de 1 bloque (no salta si hay pared de 2+)
				set {_pie} to location of {_pig}
				add vector({_dx} * 0.8, 0.1, {_dz} * 0.8) to {_pie}
				set {_alto} to location of {_pig}
				add vector({_dx} * 0.8, 1.2, {_dz} * 0.8) to {_alto}
				if block at {_pie} is solid:
					if block at {_alto} is not solid:
						if {_pig} is on ground:
							set {_vy} to 0.45

				set velocity of {_pig} to vector({_dx} * {@velocidad}, {_vy}, {_dz} * {@velocidad})
				# Girar el cuerpo suavemente hacia donde lo conduces
				# (W = hacia donde miras, A/D = diagonales o de lado, S = marcha atras sin girar)
				if {_f} is 1:
					set {_off} to {_s} * 45
				else if {_f} is 0:
					set {_off} to {_s} * 90
				else:
					set {_off} to 0
				set {_diff} to ({_yaw} + {_off}) - (yaw of {_pig})
				if {_diff} is greater than 180:
					subtract 360 from {_diff}
				if {_diff} is greater than 180:
					subtract 360 from {_diff}
				if {_diff} is less than -180:
					add 360 to {_diff}
				if {_diff} is less than -180:
					add 360 to {_diff}
				if {_diff} is greater than {@giro}:
					set {_diff} to {@giro}
				if {_diff} is less than (0 - {@giro}):
					set {_diff} to (0 - {@giro})
				set yaw of {_pig} to (yaw of {_pig}) + {_diff}
				wait 1 tick
			delete {-cnr::%{_id}%::conduciendo}
			stop
		# Barra de progreso (solo cuando ya es claramente un click mantenido)
		if {_paso} is greater than or equal to 6:
			set {_llenos} to floor({_paso} / {_total} * 20)
			set {_barra} to ""
			loop 20 times:
				if loop-number is less than or equal to {_llenos}:
					set {_barra} to "%{_barra}%§c▌"
				else:
					set {_barra} to "%{_barra}%§7▌"
			set {_resto} to ({_total} - {_paso}) / 10
			send action bar "§e☢ Armando bomba nuclear §8[%{_barra}%§8] §7%{_resto}%s" to {_p}

	# ---------- Armado: cuenta regresiva con la barra de arriba (como el Creeper Nuclear) ----------
	delete {-cnr::%{_id}%::activo}
	delete {-cnr::%{_id}%::ultimo}
	set {-cnr::%{_id}%::armado} to true
	execute console command "mm signal %{_id}% armar"
	set {_bar} to "tod4:cnr_%{_id}%"
	execute console command "bossbar add %{_bar}% {""text"":""☢ CREEPER NUCLEAR ☢"",""color"":""yellow"",""bold"":true}"
	execute console command "bossbar set %{_bar}% color yellow"
	execute console command "bossbar set %{_bar}% style notched_12"
	execute console command "bossbar set %{_bar}% max {@cuenta}"
	play sound "entity.creeper.primed" with volume 3 and pitch 0.5 at {_pig}
	play sound "block.beacon.activate" with volume 4 and pitch 0.6 at {_pig}
	send title "&c&lBOMBA PLANTADA" with subtitle "&e¡Corran al búnker!" to all players for 4 seconds
	delete {-cnr_seguro::*}
	loop {@cuenta} times:
		set {_n} to {@cuenta} - loop-number + 1
		execute console command "bossbar set %{_bar}% name {""text"":""☢ CREEPER NUCLEAR ☢  %{_n}%s"",""color"":""yellow"",""bold"":true}"
		execute console command "bossbar set %{_bar}% value %{_n}%"
		# la barra la ven todos los jugadores del server (en cualquier mundo)
		execute console command "bossbar set %{_bar}% players @a"
		# un sonido por segundo, en la misma proporcion que antes (de 10 s): count1 el primer 40%, count2 el siguiente 40%, count4 el ultimo 20%
		if {_n} > {@cuenta} * 0.6:
			set {_snd} to "count1"
		else if {_n} > {@cuenta} * 0.2:
			set {_snd} to "count2"
		else:
			set {_snd} to "count4"
		# lo escuchan todos los jugadores del server, igual de fuerte, esten donde esten
		execute console command "execute as @a at @s run playsound tod4:creeper.nuclear.%{_snd}% hostile @s ~ ~ ~ 1 1"
		if {_n} is {@bloques-desaparecen}:
			desaparecerBloques()
		# el aviso de la zona segura se revisa dos veces por segundo
		zonasAviso()
		wait 10 ticks
		zonasAviso()
		wait 10 ticks
	execute console command "bossbar remove %{_bar}%"
	explotarNuclear(location of {_pig}, {_pig})
	# cuando ya exploto, se puede volver a armar
	wait 1 second
	delete {-cnr::%{_id}%::*}

# Inmortal: no le entra ningun dano (ni la explosion, ni caidas, ni golpes)
on damage of pig:
	set {_n} to name of victim
	if {_n} contains "{@nombre}":
		cancel the event

# ===================================================================== la explosion nuclear

function explotarNuclear(l: location, causa: entity):
	# no rompe nada: la explosion es solo de efectos
	force draw 4 explosion emitter particles at {_l}
	play sound "entity.generic.explode" with volume 16 and pitch 0.5 at {_l}
	play sound "entity.lightning_bolt.thunder" with volume 16 and pitch 0.6 at {_l}
	# la explosion la escuchan todos los jugadores del server
	execute console command "execute as @a at @s run playsound minecraft:entity.generic.explode hostile @s ~ ~ ~ 1 0.5"
	execute console command "execute as @a at @s run playsound minecraft:entity.lightning_bolt.thunder hostile @s ~ ~ ~ 1 0.6"
	# mueren todos los jugadores (supervivencia/aventura) del mismo mundo hasta radio-muerte (el Nether/End no: es otro mundo)
	# (menos los que estan en una zona segura)
	loop all players:
		if world of loop-player is world of {_l}:
			if gamemode of loop-player is survival or adventure:
				if distance between loop-player and {_l} <= {@radio-muerte}:
					if enZonaSegura(location of loop-player) is false:
						kill loop-player
	delete {-cnr_seguro::*}
	# los mobs de al lado mueren
	loop all living entities in radius {@radio-mobs} of {_l}:
		if loop-entity is not a player:
			if "%uuid of loop-entity%" is not "%uuid of {_causa}%":
				damage loop-entity by 100
	hongo({_l})

# Hongo de humo: columna que sube y un sombrero que se abre arriba (como el del Creeper Nuclear).
function hongo(l: location):
	loop 120 times:
		set {_t} to loop-value-1
		set {_h} to min(30, {_t} * 0.55)
		set {_k} to 0
		while {_k} < {_h}:
			force draw 2 campfire signal smoke particles at {_l} ~ vector(0, {_k}, 0)
			add 2.5 to {_k}
		set {_rr} to min(13, 3 + {_t} * 0.14)
		loop 18 times:
			set {_a} to loop-value-2 * 20 + {_t} * 3
			set {_c} to {_l} ~ vector(cos({_a}) * {_rr}, {_h} + 2 + sin({_a} * 3) * 1.2, sin({_a}) * {_rr})
			force draw 3 campfire signal smoke particles at {_c}
			force draw 2 large smoke particles at {_c}
		force draw 10 cloud particles at {_l} ~ vector(0, {_h} + 3, 0)
		if {_t} < 25:
			set {_br} to {_t} * 1.4
			loop 24 times:
				set {_a} to loop-value-2 * 15
				force draw 1 cloud particle at {_l} ~ vector(cos({_a}) * {_br}, 0.5, sin({_a}) * {_br})
			if mod({_t}, 5) is 0:
				force draw 1 explosion emitter particle at {_l} ~ vector(0, {_h}, 0)
		wait 2 ticks

# ===================================================================== zonas seguras y bloques que desaparecen

# true = esa ubicacion esta adentro de alguna zona segura (las esquinas cuentan como bloques enteros)
function enZonaSegura(l: location) :: boolean:
	loop {cnr.z1::*}:
		set {_a} to loop-value
		set {_b} to {cnr.z2::%loop-index%}
		if {_b} is set:
			if world of {_a} is world of {_l}:
				set {_x} to x-coordinate of {_l}
				set {_y} to y-coordinate of {_l}
				set {_z} to z-coordinate of {_l}
				if {_x} >= min(x-coordinate of {_a}, x-coordinate of {_b}):
					if {_x} < max(x-coordinate of {_a}, x-coordinate of {_b}) + 1:
						if {_y} >= min(y-coordinate of {_a}, y-coordinate of {_b}):
							if {_y} < max(y-coordinate of {_a}, y-coordinate of {_b}) + 1:
								if {_z} >= min(z-coordinate of {_a}, z-coordinate of {_b}):
									if {_z} < max(z-coordinate of {_a}, z-coordinate of {_b}) + 1:
										return true
	return false

# durante la cuenta: al entrar a una zona segura, el aviso (solo a ese jugador)
function zonasAviso():
	loop all players:
		avisoZona(loop-player)

function avisoZona(p: player):
	set {_u} to uuid of {_p}
	if enZonaSegura(location of {_p}) is true:
		if {-cnr_seguro::%{_u}%} is not set:
			set {-cnr_seguro::%{_u}%} to true
			send "&a&l✔ &aEstás seguro." to {_p}
			play sound "block.note_block.chime" with volume 1 and pitch 1.5 to {_p}
	else:
		delete {-cnr_seguro::%{_u}%}

# ---------------------------------------------------------------- /nuclear prueba: todo solo para el que la usa
# El titulo, la barra, los sonidos y el aviso de la zona segura le llegan solo a el. Los bloques elegidos desaparecen
# solo en SU pantalla (para los demas siguen ahi) y al final vuelven. Nadie muere: le dice si se salvaba o no.
function pruebaNuclear(p: player, seg: number):
	set {_u} to uuid of {_p}
	set {-cnr_prueba::%{_u}%} to true
	delete {-cnr_seguro::%{_u}%}
	set {_nom} to name of {_p}
	send title "&c&lBOMBA PLANTADA" with subtitle "&e¡Corran al búnker!" to {_p} for 4 seconds
	set {_bar} to "tod4:cnrp_%{_u}%"
	execute console command "bossbar add %{_bar}% {""text"":""☢ PRUEBA ☢"",""color"":""yellow"",""bold"":true}"
	execute console command "bossbar set %{_bar}% color yellow"
	execute console command "bossbar set %{_bar}% style notched_12"
	execute console command "bossbar set %{_bar}% max %{_seg}%"
	execute console command "bossbar set %{_bar}% players %{_nom}%"
	set {_ocultos} to false
	loop {_seg} times:
		if {_p} is not online:
			execute console command "bossbar remove %{_bar}%"
			delete {-cnr_prueba::%{_u}%}
			stop
		set {_n} to {_seg} - loop-number + 1
		execute console command "bossbar set %{_bar}% name {""text"":""☢ PRUEBA ☢  %{_n}%s"",""color"":""yellow"",""bold"":true}"
		execute console command "bossbar set %{_bar}% value %{_n}%"
		if {_n} > {_seg} * 0.6:
			set {_snd} to "count1"
		else if {_n} > {_seg} * 0.2:
			set {_snd} to "count2"
		else:
			set {_snd} to "count4"
		execute console command "execute as %{_nom}% at @s run playsound tod4:creeper.nuclear.%{_snd}% hostile @s ~ ~ ~ 1 1"
		if {_n} is {@bloques-desaparecen}:
			set {_ocultos} to true
			loop {cnr.bloques::*}:
				make {_p} see block at loop-value-2 as air
		avisoZona({_p})
		wait 10 ticks
		if {_p} is online:
			avisoZona({_p})
		wait 10 ticks
	execute console command "bossbar remove %{_bar}%"
	delete {-cnr_prueba::%{_u}%}
	delete {-cnr_seguro::%{_u}%}
	if {_p} is not online:
		stop
	execute console command "execute as %{_nom}% at @s run playsound minecraft:entity.generic.explode hostile @s ~ ~ ~ 1 0.5"
	if enZonaSegura(location of {_p}) is true:
		send "&a&l✔ &a(Prueba) Te salvabas: estabas en una zona segura." to {_p}
	else:
		send "&c&l✖ &c(Prueba) Te morías: no estabas en una zona segura." to {_p}
	if {_ocultos} is false:
		send "&7(Prueba) Los bloques no llegaron a desaparecer: la prueba duró menos de {@bloques-desaparecen} s." to {_p}
	wait 3 seconds
	# los bloques vuelven a verse como son
	if {_p} is online:
		loop {cnr.bloques::*}:
			make {_p} see block at loop-value as block data of block at loop-value

# los bloques elegidos desaparecen (se guarda como eran, para /nuclear restaurar)
function desaparecerBloques():
	loop {cnr.bloques::*}:
		set {_b} to block at loop-value
		if {_b} is not air:
			set {cnr.guardado::%loop-index%} to "%block data of {_b}%"
			force draw 6 large smoke particles at centro(loop-value)
			set block at loop-value to air

function restaurarBloques() :: number:
	set {_n} to 0
	loop {cnr.guardado::*}:
		set {_l} to {cnr.bloques::%loop-index%}
		if {_l} is set:
			set {_bd} to loop-value parsed as block data
			if {_bd} is set:
				set block data of block at {_l} to {_bd}
				add 1 to {_n}
	delete {cnr.guardado::*}
	return {_n}

# el centro del bloque de esa ubicacion, como una ubicacion NUEVA (sumarle algo a la guardada la movia)
function centro(l: location) :: location:
	return location((floor(x-coordinate of {_l})) + 0.5, (floor(y-coordinate of {_l})) + 0.5, (floor(z-coordinate of {_l})) + 0.5, world of {_l})

# una particula que ve SOLO ese jugador (en su mundo)
function particulaPara(p: player, tipo: text, l: location, n: number):
	if world of {_l} is not world of {_p}:
		stop
	execute console command "execute as %name of {_p}% at @s run particle minecraft:%{_tipo}% %x-coordinate of {_l}% %y-coordinate of {_l}% %z-coordinate of {_l}% 0.15 0.15 0.15 0 %{_n}% force @s"

# las particulas de /nuclear ver (una vez), solo para el que lo usa
function verMarcas(p: player):
	loop {cnr.bloques::*}:
		particulaPara({_p}, "happy_villager", centro(loop-value), 4)
	loop {cnr.z1::*}:
		particulaPara({_p}, "flame", centro(loop-value), 4)
		set {_d} to {cnr.z2::%loop-index%}
		if {_d} is set:
			particulaPara({_p}, "flame", centro({_d}), 4)

function toggleBloque(p: player, l: location):
	if {cnr.bloques::*} contains {_l}:
		remove {_l} from {cnr.bloques::*}
		send "&c- &7Bloque sacado. Quedan &f%size of {cnr.bloques::*}% &7bloques que desaparecen." to {_p}
	else:
		add {_l} to {cnr.bloques::*}
		send "&a+ &7Bloque agregado. Hay &f%size of {cnr.bloques::*}% &7bloques que desaparecen (a los {@bloques-desaparecen} s del final)." to {_p}
		particulaPara({_p}, "happy_villager", centro({_l}), 8)

function guardarZona(p: player):
	set {_u} to uuid of {_p}
	if {cnr.p1::%{_u}%} is not set:
		send "&7Esquina 2 marcada. Falta la esquina 1 (click izquierdo con la Zona Segura)." to {_p}
		stop
	if {cnr.p2::%{_u}%} is not set:
		send "&7Esquina 1 marcada. Falta la esquina 2 (click derecho con la Zona Segura)." to {_p}
		stop
	set {_a} to {cnr.p1::%{_u}%}
	set {_b} to {cnr.p2::%{_u}%}
	if world of {_a} is not world of {_b}:
		send "&c✖ Las dos esquinas tienen que estar en el mismo mundo." to {_p}
		stop
	add 1 to {cnr.zonas_n}
	set {cnr.z1::%{cnr.zonas_n}%} to {_a}
	set {cnr.z2::%{cnr.zonas_n}%} to {_b}
	delete {cnr.p1::%{_u}%}
	delete {cnr.p2::%{_u}%}
	set {_dx} to abs(x-coordinate of {_a} - x-coordinate of {_b}) + 1
	set {_dy} to abs(y-coordinate of {_a} - y-coordinate of {_b}) + 1
	set {_dz} to abs(z-coordinate of {_a} - z-coordinate of {_b}) + 1
	send "&a✔ Zona segura #%{cnr.zonas_n}% guardada &7(%{_dx}% x %{_dy}% x %{_dz}% bloques). Hay &f%size of {cnr.z1::*}% &7zona(s)." to {_p}

on right click:
	if name of player's tool is "&e&lSelector Nuclear":
		player has permission "tod4.admin"
		cancel event
		if event-block is set:
			toggleBloque(player, location of event-block)
		stop
	if name of player's tool is "&a&lZona Segura":
		player has permission "tod4.admin"
		cancel event
		if event-block is set:
			set {cnr.p2::%uuid of player%} to location of event-block
			guardarZona(player)

on left click:
	if name of player's tool is "&e&lSelector Nuclear":
		cancel event
		stop
	if name of player's tool is "&a&lZona Segura":
		player has permission "tod4.admin"
		cancel event
		if event-block is set:
			set {cnr.p1::%uuid of player%} to location of event-block
			guardarZona(player)

command /nuclear [<text>] [<text>]:
	permission: tod4.admin
	permission message: &c✖ No tienes permiso.
	trigger:
		if arg-1 is not set:
			give player blaze rod named "&e&lSelector Nuclear" with lore "&7Click derecho a un bloque: lo agrega o lo saca" and "&7de los que desaparecen (a los {@bloques-desaparecen} s del final)."
			give player golden shovel named "&a&lZona Segura" with lore "&7Click izquierdo: esquina 1" and "&7Click derecho: esquina 2 (se guarda la zona)"
			send "&e☢ &7Herramientas del Creeper Nuclear. Mas: &f/nuclear prueba [segundos] | bloque | ver | lista | restaurar | borrar bloques | borrar zonas" to player
			stop
		if arg-1 is "bloque":
			set {_t} to target block of player
			if {_t} is not set:
				send "&c✖ No estas mirando ningun bloque." to player
				stop
			if {_t} is air:
				send "&c✖ No estas mirando ningun bloque." to player
				stop
			toggleBloque(player, location of {_t})
			stop
		if arg-1 is "prueba":
			if {-cnr_prueba::%uuid of player%} is set:
				send "&c✖ Ya tienes una prueba corriendo." to player
				stop
			set {_seg} to {@cuenta}
			if arg-2 is set:
				set {_x} to arg-2 parsed as integer
				if {_x} is set:
					if {_x} >= 5:
						set {_seg} to {_x}
			send "&e☢ &7Prueba de &f%{_seg}% s&7: solo la ves vos y nadie muere." to player
			pruebaNuclear(player, {_seg})
			stop
		if arg-1 is "lista":
			send "&e☢ &7Bloques que desaparecen: &f%size of {cnr.bloques::*}% &7| guardados para restaurar: &f%size of {cnr.guardado::*}% &7| zonas seguras: &f%size of {cnr.z1::*}%" to player
			stop
		if arg-1 is "restaurar":
			set {_n} to restaurarBloques()
			send "&a✔ Volvieron &f%{_n}% &abloques." to player
			stop
		if arg-1 is "borrar":
			if arg-2 is "bloques":
				delete {cnr.bloques::*}
				delete {cnr.guardado::*}
				send "&a✔ Se borraron los bloques elegidos." to player
			else if arg-2 is "zonas":
				delete {cnr.z1::*}
				delete {cnr.z2::*}
				send "&a✔ Se borraron las zonas seguras." to player
			else:
				send "&7Uso: &f/nuclear borrar bloques &7o &f/nuclear borrar zonas" to player
			stop
		if arg-1 is "ver":
			send "&e☢ &7Mostrando 10 s: bloques elegidos (verde) y esquinas de las zonas seguras (llamas)." to player
			loop 20 times:
				verMarcas(player)
				wait 10 ticks
			stop
		send "&7Uso: &f/nuclear [prueba [segundos] | bloque | ver | lista | restaurar | borrar bloques | borrar zonas]" to player
