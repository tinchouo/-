# solo para el CI: hace explotar un chancho con la explosion del Creeper Nuclear con ruedas
command /probarnuclear:
	trigger:
		set {_l} to location(0, -60, 0, world "world")
		spawn a pig at {_l}
		set {_p} to last spawned entity
		set name of {_p} to "Creeper Nuclear"
		make {_p} invulnerable
		set {_id} to "%uuid of {_p}%"
		set {_bar} to "tod4:cnr_%{_id}%"
		execute console command "bossbar add %{_bar}% {""text"":""☢ CREEPER NUCLEAR ☢"",""color"":""yellow"",""bold"":true}"
		execute console command "bossbar set %{_bar}% name {""text"":""☢ CREEPER NUCLEAR ☢  5s"",""color"":""yellow"",""bold"":true}"
		execute console command "execute at %{_id}% run bossbar set %{_bar}% players @a[distance=..80]"
		execute console command "execute at %{_id}% run playsound tod4:creeper.nuclear.count1 hostile @a ~ ~ ~ 5 1"
		execute console command "bossbar list"
		execute console command "bossbar remove %{_bar}%"
		set {_antes} to 0
		loop blocks in radius 6 of {_l}:
			if loop-block is air:
				add 1 to {_antes}
		explotarNuclear({_l}, {_p})
		wait 3 seconds
		set {_aire} to 0
		loop blocks in radius 6 of {_l}:
			if loop-block is air:
				add 1 to {_aire}
		if {_aire} is {_antes}:
			broadcast "NUCLEAR_PRUEBA no rompio nada"
		else:
			broadcast "NUCLEAR_PRUEBA ROMPIO BLOQUES"
		set {_vivo} to "no"
		if {_p} is alive:
			set {_vivo} to "si"
		broadcast "NUCLEAR_PRUEBA chancho vivo: %{_vivo}% | aire cerca: %{_aire}%"

on death of pig:
	broadcast "NUCLEAR_PRUEBA murio el chancho: %damage cause% | nombre: %name of victim%"

# solo para el CI: bloques que desaparecen y vuelven, y la zona segura
command /probarbloques:
	trigger:
		set {_l} to location(5, -60, 5, world "world")
		execute console command "setblock 5 -60 5 minecraft:oak_stairs[facing=east,half=top]"
		wait 2 ticks
		set {_antes} to "%block data of block at {_l}%"
		delete {cnr.bloques::*}
		delete {cnr.guardado::*}
		add {_l} to {cnr.bloques::*}
		desaparecerBloques()
		set {_medio} to "%type of block at {_l}%"
		set {_n} to restaurarBloques()
		set {_despues} to "%block data of block at {_l}%"
		broadcast "BLOQUES_PRUEBA antes=%{_antes}% | medio=%{_medio}% | despues=%{_despues}% | n=%{_n}%"
		if {_antes} is {_despues}:
			broadcast "BLOQUES_PRUEBA OK"
		delete {cnr.bloques::*}
		delete {cnr.z1::*}
		delete {cnr.z2::*}
		set {cnr.z1::1} to location(0, -61, 0, world "world")
		set {cnr.z2::1} to location(3, -58, 3, world "world")
		set {_a} to enZonaSegura(location(2.5, -60, 2.5, world "world"))
		set {_b} to enZonaSegura(location(10, -60, 10, world "world"))
		set {_c} to enZonaSegura(location(3.9, -60, 3.9, world "world"))
		broadcast "ZONA_PRUEBA adentro=%{_a}% | afuera=%{_b}% | borde=%{_c}%"
		if {_a} is true:
			if {_b} is false:
				if {_c} is true:
					broadcast "ZONA_PRUEBA OK"
		delete {cnr.z1::*}
		delete {cnr.z2::*}

# solo para el CI: /nuclear ver no puede mover lo guardado
command /probarver:
	trigger:
		delete {cnr.bloques::*}
		delete {cnr.z1::*}
		delete {cnr.z2::*}
		add location(5, -60, 5, world "world") to {cnr.bloques::*}
		set {cnr.z1::1} to location(0, -61, 0, world "world")
		set {cnr.z2::1} to location(3, -58, 3, world "world")
		loop 5 times:
			verMarcas()
		set {_b} to first element of {cnr.bloques::*}
		broadcast "VER_PRUEBA bloque=%x-coordinate of {_b}% %y-coordinate of {_b}% %z-coordinate of {_b}% | z2=%x-coordinate of {cnr.z2::1}%"
		if x-coordinate of {_b} is 5:
			if x-coordinate of {cnr.z2::1} is 3:
				broadcast "VER_PRUEBA OK"
		# asi era antes (sumarle a la ubicacion de la lista): ¿la movia?
		set {_lista::1} to location(5, -60, 5, world "world")
		loop {_lista::*}:
			set {_c} to loop-value
			add vector(0.5, 0.5, 0.5) to {_c}
		broadcast "VER_ANTES la de la lista quedo en x=%x-coordinate of {_lista::1}%"
		delete {cnr.bloques::*}
		delete {cnr.z1::*}
		delete {cnr.z2::*}
